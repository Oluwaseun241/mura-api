# Environment variables for the Food Classifier API

# Model configuration
MODEL_PATH=food_classifier.pth
IMAGE_SIZE=512

# Server configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Logging
LOG_LEVEL=INFO

# CORS settings (for production, specify your domain)
CORS_ORIGINS=*

# Optional: GPU settings
CUDA_VISIBLE_DEVICES=0

# Cloudinary Configuration (for cloud storage)
# Set USE_CLOUDINARY=true to enable Cloudinary storage
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_FOLDER=food-classifier
